		"prop-types": "^15.8.1",
		"react-scan": "^0.3.4",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"packageManager": "yarn@4.9.1"
