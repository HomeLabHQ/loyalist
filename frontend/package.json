    "@mantine/notifications": "^8.0.1",
    "@reduxjs/toolkit": "^2.4.0",
    "@tabler/icons-react": "^3.24.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.0.2",
