	},
	"dependencies": {
		"@mantine/core": "8.1.1",
		"@mantine/dates": "^8.1.1",
		"@mantine/dropzone": "^8.1.1",
		"@mantine/form": "^8.1.1",
		"@mantine/hooks": "8.1.1",
		"@mantine/notifications": "^8.1.1",
		"@reduxjs/toolkit": "^2.8.2",
		"@tabler/icons-react": "^3.24.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.13",
		"i18next": "^23.15.1",
		"i18next-browser-languagedetector": "^8.2.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^15.0.2",
		"react-redux": "^9.1.2",
		"react-router-dom": "^7.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.4",
