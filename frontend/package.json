{
	"name": "remembrancer-frontend",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite",
		"api": "npx @rtk-query/codegen-openapi openapi-config.json",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
